# PostGIS connection string for the osm2pgsql database.
# Copy this file to .env and fill in your values.
# The CLI flag --postgis-url overrides this value.
#
# NOTE: Prefer .env over --postgis-url on multi-user systems to avoid
# the connection string appearing in `ps aux` output.
POSTGIS_URL=postgresql://osm:osm@localhost:5432/gis
